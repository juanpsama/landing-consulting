---
// src/layouts/Layout.astro
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import GoogleTagManager from "../components/reusable/GoogleTagManager.astro";
import { ui } from "../i18n/ui";
import WhatsappButton from "../components/WhatsappButton.astro";

export interface Props {
	lang: string;
	title?: string;
	description?: string;
}

const { lang, title, description } = Astro.props;

const finalLang =
	(lang as keyof typeof ui) ??
	(Astro.currentLocale as keyof typeof ui) ??
	"es";
const t = ui[finalLang];
const finalTitle = title ? `${title} | ${t["site.title"]}` : t["site.title"];
const finalDescription = description ?? t["site.description"];

// 1. Manejo seguro de la ruta actual
const cleanPathname = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname.slice(0, -1)
	: Astro.url.pathname;

const baseOrigin = import.meta.env.PROD ? Astro.site : Astro.url;

const canonicalURL = new URL(cleanPathname, baseOrigin);

// 2. Función para generar las URLs alternativas conservando la ruta
const getAlternateUrl = (targetLang: string) => {
	const base = import.meta.env.BASE_URL.replace(/\/$/, "");
	const pathWithoutBase = cleanPathname.startsWith(base)
		? cleanPathname.slice(base.length)
		: cleanPathname;

	const regex = new RegExp(`^\\/${finalLang}(\\/|$)`);
	let newPath = pathWithoutBase.replace(regex, `/${targetLang}$1`);

	if (newPath === pathWithoutBase && pathWithoutBase.startsWith("/")) {
		newPath = `/${targetLang}${pathWithoutBase}`;
	}

	return new URL(`${base}${newPath}`, Astro.site).href;
};

// 3. Generamos las URLs correctas para cada idioma
const esUrl = getAlternateUrl("es");
const enUrl = getAlternateUrl("en");
// Google Tag Manager ID
const GTM_ID = "GTM-NTN5CL8T";
---

<html lang={lang}>
	<head>
		<GoogleTagManager id={GTM_ID} part="head" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={finalDescription} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{finalTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<GoogleTagManager id={GTM_ID} part="body" />
		<WhatsappButton area_code="+52" whatsapp="9612401220" />
		<NavBar />
		<slot />

		<Footer />

		<script is:inline>
			document.addEventListener("click", function (event) {
				// Busca si a lo que le dimos clic (o su contenedor) tiene data-track
				const trackElement = event.target.closest("[data-track]");

				if (trackElement) {
					const trackValue = trackElement.getAttribute("data-track");

					// Forzamos el envío del dato al dataLayer de Google
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						event: "dl_clic_trackeado",
						accion_boton: trackValue,
					});

					// Imprimimos en consola para que tú confirmes que funciona en local/prod
					console.log("🚀 Dato empujado a GTM:", trackValue);
				}
			});
		</script>
	</body>
</html>
