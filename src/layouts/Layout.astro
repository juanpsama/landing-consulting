---
// src/layouts/Layout.astro
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import GoogleTagManager from "../components/reusable/GoogleTagManager.astro";
import { ui, defaultLang, showDefaultLang } from "../i18n/ui";
import WhatsappButton from "../components/WhatsappButton.astro";
import { generateOrganizationSchema } from "../utils/schemaBuilder";
import seoData from "../data/seo.json";
export interface Props {
	lang: string;
	title?: string;
	description?: string;
	image?: string;
}

const { lang, title, description, image } = Astro.props;

const finalLang =
	(lang as keyof typeof ui) ??
	(Astro.currentLocale as keyof typeof ui) ??
	"es";
const t = ui[finalLang];
const finalTitle = title ? `${title} | ${t["site.title"]}` : t["site.title"];
const finalDescription = description ?? t["site.description"];

const domain =
	import.meta.env.PROD && Astro.site ? Astro.site : Astro.url.origin;

const canonicalURL = new URL(Astro.url.pathname, domain);
const defaultImage = "/garpe-thumbnail.jpg";
const finalImage = image ?? defaultImage;
const thumbnailURL = new URL(finalImage, domain).href;

const isPng = thumbnailURL.toLowerCase().endsWith(".png");
const imageType = isPng ? "image/png" : "image/jpeg";
const imageWidth = isPng ? "2400" : "2752";
const imageHeight = isPng ? "1400" : "1536";

const getAlternateUrl = (targetLang: string) => {
	const currentLang = Astro.currentLocale || defaultLang;

	let path = Astro.url.pathname;

	const base =
		import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;

	if (base && path.startsWith(base)) {
		path = path.slice(base.length);
	}

	const segments = path.split("/").filter(Boolean);

	if (segments[0] === currentLang) {
		segments.shift();
	}

	if (targetLang !== defaultLang || showDefaultLang) {
		segments.unshift(targetLang);
	}

	const newPath = `${base}/${segments.join("/")}`;

	return new URL(newPath, domain).href;
};

// 3. Generamos las URLs correctas para cada idioma
const esUrl = getAlternateUrl("es");
const enUrl = getAlternateUrl("en");
// Google Tag Manager ID
const GTM_ID = "GTM-NTN5CL8T";

const jsonLdSchema = generateOrganizationSchema(seoData, t, finalLang);
---

<html lang={lang}>
	<head>
		<GoogleTagManager id={GTM_ID} part="head" />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={finalDescription} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{finalTitle}</title>

		<!-- OpenGraph / Social Meta -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={finalTitle} />
		<meta property="og:description" content={finalDescription} />
		<meta property="og:image" content={thumbnailURL} />
		<meta property="og:image:secure_url" content={thumbnailURL} />
		<meta property="og:image:type" content={imageType} />
		<meta property="og:image:width" content={imageWidth} />
		<meta property="og:image:height" content={imageHeight} />
		<meta property="og:image:alt" content={finalTitle} />
		<meta
			property="og:locale"
			content={finalLang === "es" ? "es_MX" : "en_US"}
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={finalTitle} />
		<meta name="twitter:description" content={finalDescription} />
		<meta name="twitter:image" content={thumbnailURL} />
		<meta name="twitter:image:alt" content={finalTitle} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap"
			rel="stylesheet"
		/>
		<script
			type="application/ld+json"
			set:html={JSON.stringify(jsonLdSchema)}
		/>
	</head>
	<body>
		<GoogleTagManager id={GTM_ID} part="body" />
		<WhatsappButton area_code="+52" whatsapp="9612401220" />
		<NavBar />
		<slot />

		<Footer />

		<script is:inline>
			document.addEventListener("click", function (event) {
				// Busca si a lo que le dimos clic (o su contenedor) tiene data-track
				const trackElement = event.target.closest("[data-track]");

				if (trackElement) {
					const trackValue = trackElement.getAttribute("data-track");

					// Forzamos el envío del dato al dataLayer de Google
					window.dataLayer = window.dataLayer || [];
					window.dataLayer.push({
						event: "dl_clic_trackeado",
						accion_boton: trackValue,
					});

					// Imprimimos en consola para que tú confirmes que funciona en local/prod
					console.log("[GTM] Dato empujado a GTM:", trackValue);
				}
			});
		</script>
	</body>
</html>
