---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
// import ServicesSection from '../components/ServicesSection.astro';
import ServicesSection from "../components/ServicesSection_0001.astro";
import Footer from "../components/Footer.astro";

export interface Props {
	lang: string;
	title: string;
	description: string;
	h1: string;
	subtitle: string;
	cta: string;
	services: string;
}

const { lang, title, description, h1, subtitle, cta, services } = Astro.props;
const origin = Astro.site!.origin.replace(/\/$/, "");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const esUrl = `${origin}${base}/es/`;
const enUrl = `${origin}${base}/en/`;

const cleanPathname = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;

const canonicalURL = new URL(cleanPathname, Astro.site);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={esUrl} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<NavBar />
		<HeroSection {h1} {subtitle} {cta} {services} />
		<ServicesSection />
		<Footer />
	</body>
</html>
