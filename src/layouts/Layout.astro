---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';

export interface Props {
  lang: string;
  title: string;
  description: string;
  h1: string;
  subtitle: string;
  cta: string;
  services: string;
}

const { lang, title, description, h1, subtitle, cta, services } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <NavBar />
    <section class="pt-[184px] pb-[120px] px-8 bg-gradient-to-b from-hero-sky-from to-hero-sky-to flex flex-col items-center text-center">
      <div class="w-full max-w-[1280px] px-8">
        <h1 class="text-[clamp(2.25rem,5vw,72px)] font-semibold leading-[1.05] tracking-[-2px] max-w-[16ch] mx-auto text-ink" set:html={h1} />
        <p class="mt-6 text-lg font-normal leading-[1.5] text-charcoal max-w-[48ch] mx-auto">{subtitle}</p>
        <div class="mt-8 flex gap-3 flex-wrap justify-center">
          <a href="#contact" class="inline-block bg-brand-green text-primary text-sm font-medium leading-[1.3] px-5 py-[10px] rounded-pill no-underline transition-colors duration-150 hover:bg-brand-green-deep">{cta}</a>
          <a href="#services" class="inline-block bg-transparent text-ink text-sm font-medium leading-[1.3] px-5 py-[10px] rounded-pill no-underline border border-hairline transition-colors duration-150 hover:bg-surface">{services}</a>
        </div>
      </div>
    </section>
  </body>
</html>
