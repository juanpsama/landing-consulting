---
import solutionsData from "../data/solutions.json";
import imgDocManager from "../assets/images/document_manager.webp";
import imgDocManager2 from "../assets/images/document_manager_2.webp";
import imgJpicourl from "../assets/images/jpicourl_1.webp";
import imgOdoo1 from "../assets/images/odoo_1.webp";
import imgOdoo2 from "../assets/images/odoo_2.webp";

const imageMap: Record<string, string> = {
  "document_manager.webp": imgDocManager.src,
  "document_manager_2.webp": imgDocManager2.src,
  "jpicourl_1.webp": imgJpicourl.src,
  "odoo_1.webp": imgOdoo1.src,
  "odoo_2.webp": imgOdoo2.src,
};

const lang = (Astro.currentLocale ?? "es") as keyof typeof solutionsData;
const data = solutionsData[lang];
const numSlides = data.solutions.length;
const extraScrollHeight = `${(numSlides - 1) * 80}vh`;
---

<section id="carousel3d" class="relative">
  <div class="max-w-[1280px] mx-auto px-8 pt-24 pb-16 text-center">
    <h2 class="text-[28px] lg:text-[36px] font-semibold text-ink leading-tight">
      {data.heading}
    </h2>
    <p class="mt-4 text-lg text-charcoal max-w-[48ch] mx-auto leading-relaxed">
      {data.subtitle}
    </p>
  </div>

  <div
    class="px-[5%]"
    data-carousel3d-wrapper
    style={`height: calc(80vh + ${extraScrollHeight})`}
  >
    <div
      class="carousel3d-viewport sticky h-[80vh] overflow-hidden rounded-lg"
      style="top: calc(64px + 2vh)"
      data-num-slides={numSlides}
    >
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-ink/10 z-20">
        <div
          class="h-full w-0 bg-brand-green transition-[width] duration-300"
          data-progress-bar
        >
        </div>
      </div>

      <div
        class="absolute bottom-[3vh] right-[5%] z-20 text-[0.85rem] font-medium text-ink/50 tabular-nums tracking-[0.05em]"
      >
        <span class="text-ink" data-counter-current>01</span>
        <span> /</span>
        <span>{String(numSlides).padStart(2, "0")}</span>
      </div>

      <div class="carousel3d-scene">
        {
          data.solutions.map((solution, i) => (
            <div
              class={`carousel3d-card ${i === 0 ? "pos-center" : ""}`}
              data-card-index={i}
            >
              <img
                class="carousel3d-img"
                src={imageMap[solution.image]}
                alt={solution.title}
                loading={i === 0 ? "eager" : "lazy"}
              />
              <div class="carousel3d-label">
                <h3>{solution.title}</h3>
                <p>{solution.description}</p>
                <div class="flex gap-2 flex-wrap">
                  {solution.tags.map((tag) => (
                    <span class="inline-block py-[0.25rem] px-[0.7rem] text-[0.75rem] font-medium text-white/90 bg-white/15 backdrop-blur-[8px] border border-white/20 rounded-pill">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Lets make this carrousel responsive, the text overflows the image and the image is to small on mobile -->
<style is:global>
  .carousel3d-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
  }

  .carousel3d-card {
    position: absolute;
    width: 60vw;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.3);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.65s ease,
      filter 0.65s ease, box-shadow 0.65s ease;
    will-change: transform, opacity;
  }

  /* ── Center (active) ── */
  .carousel3d-card.pos-center {
    transform: translateX(0) translateZ(0) rotateY(0deg) scale(1);
    opacity: 1;
    z-index: 5;
    pointer-events: auto;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.4);
  }

  /* ── Left side ── */
  .carousel3d-card.pos-left-1 {
    transform: translateX(-48%) translateZ(-200px) rotateY(30deg) scale(0.55);
    opacity: 0.85;
    z-index: 4;
    filter: brightness(0.75);
  }

  .carousel3d-card.pos-left-2 {
    transform: translateX(-70%) translateZ(-400px) rotateY(30deg) scale(0.42);
    opacity: 0.45;
    z-index: 3;
    filter: brightness(0.45);
  }

  /* ── Right side ── */
  .carousel3d-card.pos-right-1 {
    transform: translateX(48%) translateZ(-200px) rotateY(-30deg) scale(0.55);
    opacity: 0.85;
    z-index: 4;
    filter: brightness(0.75);
  }

  .carousel3d-card.pos-right-2 {
    transform: translateX(70%) translateZ(-400px) rotateY(-30deg) scale(0.42);
    opacity: 0.45;
    z-index: 3;
    filter: brightness(0.45);
  }

  /* ── Hidden ── */
  .carousel3d-card.pos-hidden {
    transform: translateX(0) translateZ(-500px) rotateY(0deg) scale(0.5);
    opacity: 0;
    z-index: 1;
  }

  .carousel3d-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel3d-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      transparent 100%
    );
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .carousel3d-card.pos-center .carousel3d-label {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.15s;
  }

  .carousel3d-label h3 {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .carousel3d-label p {
    font-size: clamp(0.75rem, 1.2vw, 0.85rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    max-width: 45ch;
  }
</style>

<script>
  function initCarousel3D() {
    const wrapper = document.querySelector(
      "[data-carousel3d-wrapper]",
    ) as HTMLElement;
    const viewport = document.querySelector(
      ".carousel3d-viewport",
    ) as HTMLElement;
    if (!wrapper || !viewport) return;

    const numSlides = parseInt(viewport.dataset.numSlides || "5", 10);
    const cards = viewport.querySelectorAll<HTMLElement>(".carousel3d-card");
    const progressBar = viewport.querySelector<HTMLElement>(
      "[data-progress-bar]",
    );
    const counterCurrent = viewport.querySelector<HTMLElement>(
      "[data-counter-current]",
    );
    if (!cards.length || !progressBar || !counterCurrent) return;

    let currentActive = 0;

    function updateActive(newIndex: number) {
      if (newIndex === currentActive) return;

      cards.forEach((card, i) => {
        card.classList.remove(
          "pos-center",
          "pos-left-1",
          "pos-left-2",
          "pos-right-1",
          "pos-right-2",
          "pos-hidden",
        );

        const offset = i - newIndex;

        if (offset === 0) {
          card.classList.add("pos-center");
        } else if (offset === -1) {
          card.classList.add("pos-left-1");
        } else if (offset <= -2) {
          card.classList.add("pos-left-2");
        } else if (offset === 1) {
          card.classList.add("pos-right-1");
        } else if (offset >= 2) {
          card.classList.add("pos-right-2");
        }
      });

      currentActive = newIndex;
      progressBar.style.width = `${(newIndex / (numSlides - 1)) * 100}%`;
      counterCurrent.textContent = String(newIndex + 1).padStart(2, "0");
    }

    function onScroll() {
      const wrapperRect = wrapper.getBoundingClientRect();
      const viewportHeight = viewport.offsetHeight;
      const scrollableHeight = (numSlides - 1) * viewportHeight;

      const wrapperTop = -wrapperRect.top;
      const progress = Math.max(0, Math.min(1, wrapperTop / scrollableHeight));
      const index = Math.round(progress * (numSlides - 1));
      updateActive(index);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener("DOMContentLoaded", initCarousel3D);
</script>
