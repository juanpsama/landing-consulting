---
// src/components/ServicesSection_0001.astro
import ServiceCard from "./ServiceCard.astro";
import servicesData from "../data/services_0001.json";
import monitorIcon from "../assets/icons/monitor.svg?raw";
import globeIcon from "../assets/icons/globe.svg?raw";
import linkIcon from "../assets/icons/link.svg?raw";
import refreshIcon from "../assets/icons/refresh.svg?raw";
import databaseIcon from "../assets/icons/database.svg?raw";
import lightbulbIcon from "../assets/icons/lightbulb.svg?raw";
import cloudIcon from "../assets/icons/cloud.svg?raw";
import chartIcon from "../assets/icons/chart.svg?raw";
import bookIcon from "../assets/icons/book.svg?raw";

const iconMap: Record<string, string> = {
	monitor: monitorIcon,
	globe: globeIcon,
	link: linkIcon,
	refresh: refreshIcon,
	database: databaseIcon,
	lightbulb: lightbulbIcon,
	cloud: cloudIcon,
	chart: chartIcon,
	book: bookIcon,
};

const lang = (Astro.currentLocale ?? "es") as keyof typeof servicesData;
const data = servicesData[lang];

// Filtramos los servicios usando el nuevo atributo del JSON
const featuredServices = data.services.filter((s) => s.featured);
const secondaryServices = data.services.filter((s) => !s.featured);

const accentVars = [
	"--color-brand-green",
	"--color-brand-tag",
	"--color-testimonial-orange",
];
---

<section id="services" class="py-16 lg:py-24 bg-canvas">
	<div class="max-w-7xl mx-auto px-8">
		<!-- Encabezado Principal -->
		<header class="text-center mb-16">
			<h2
				class="text-[28px] lg:text-[36px] font-semibold text-ink leading-tight"
			>
				{data.heading}
			</h2>
			<p
				class="mt-4 text-lg text-charcoal max-w-[54ch] mx-auto leading-relaxed"
			>
				{data.subtitle}
			</p>
		</header>

		<!-- 3 Servicios Core (Destacados) -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
			{
				featuredServices.map((service, index) => {
					const accentVar = accentVars[index % accentVars.length];

					return (
						<ServiceCard
							title={service.title}
							description={service.description}
							icon={iconMap[service.icon]}
							accentVar={accentVar}
							variant={"light"}
						/>
					);
				})
			}
		</div>

		<!-- Separador sutil -->
		<div class="w-full h-px bg-hairline mb-16"></div>

		<!-- Servicios Secundarios (Lista compacta para no saturar) -->
		<div class="max-w-5xl mx-auto">
			<h3
				class="text-xl font-medium text-ink mb-8 text-center md:text-left"
			>
				{data.secondaryHeading}
			</h3>

			<div
				class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-6"
			>
				{
					secondaryServices.map((service) => (
						<div class="flex items-start gap-4 p-4 rounded-xl hover:bg-surface transition-colors duration-200">
							<div
								class="w-10 h-10 shrink-0 flex items-center justify-center text-steel bg-canvas rounded-lg shadow-sm"
								set:html={iconMap[service.icon]}
							/>
							<div>
								<h4 class="text-base font-semibold text-ink leading-tight mb-1">
									{service.title}
								</h4>
								<p class="text-sm text-steel leading-relaxed">
									{service.description}
								</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
