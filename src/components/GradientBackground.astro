---
// src/components/GradientBackground.astro
---

<div
	class="absolute inset-0 overflow-hidden gradient-container z-[-1]"
	aria-hidden="true"
>
	<canvas id="gradient-canvas" class="w-full h-full"></canvas>
</div>

<style>
	.gradient-container {
		/* Mantenemos el fondo base usando tus variables CSS de Tailwind */
		background: linear-gradient(
			40deg,
			var(--color-hero-sky-from),
			var(--color-hero-sky-to)
		);
		/* Restauramos la máscara para que se difumine hacia abajo, igual que tu código original */
		mask-image: linear-gradient(
			to bottom,
			black 0%,
			black 70%,
			transparent 100%
		);
		-webkit-mask-image: linear-gradient(
			to bottom,
			black 0%,
			black 70%,
			transparent 100%
		);
	}
</style>

<script>
	const canvas = document.getElementById(
		"gradient-canvas",
	) as HTMLCanvasElement | null;

	if (canvas) {
		const ctx = canvas.getContext("2d");
		let animationFrameId: number;
		let isVisible = false;

		let curX = 0,
			curY = 0;
		let tgX = 0,
			tgY = 0;
		let time = 0;

		const resizeCanvas = () => {
			const dpr = window.devicePixelRatio || 1;
			canvas.width = window.innerWidth * dpr;
			canvas.height = window.innerHeight * dpr;
			ctx?.scale(dpr, dpr);
		};

		window.addEventListener("resize", resizeCanvas);
		resizeCanvas();

		curX = tgX = window.innerWidth / 2;
		curY = tgY = window.innerHeight / 2;

		window.addEventListener(
			"mousemove",
			(e) => {
				if (!isVisible) return;
				tgX = e.clientX;
				tgY = e.clientY;
			},
			{ passive: true },
		);

		const drawGradient = (
			x: number,
			y: number,
			radius: number,
			colorIn: string,
			colorOut: string,
		) => {
			if (!ctx) return;
			const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
			gradient.addColorStop(0, colorIn);
			gradient.addColorStop(1, colorOut);
			ctx.fillStyle = gradient;
			ctx.beginPath();
			ctx.arc(x, y, radius, 0, Math.PI * 2);
			ctx.fill();
		};

		const render = () => {
			if (!isVisible || !ctx) return;

			// Limpiar el fotograma
			ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

			// Aplicar el mix-blend-mode: hard-light nativo de Canvas
			ctx.globalCompositeOperation = "hard-light";

			const w = window.innerWidth;
			const h = window.innerHeight;
			time += 0.005; // Controla la velocidad de las esferas

			// --- TUS COLORES MAPEADOS DESDE EL :ROOT ---

			// g1: Brand Gold (Movimiento vertical)
			const g1Y = h * 0.5 + Math.sin(time) * h * 0.4;
			drawGradient(
				w * 0.3,
				g1Y,
				w * 0.4,
				"rgba(215, 188, 106, 0.45)",
				"rgba(215, 188, 106, 0)",
			);

			// g2: Brand Green (Movimiento circular inverso)
			const g2X = w * 0.5 + Math.cos(time * 0.8) * w * 0.2;
			const g2Y = h * 0.5 - Math.sin(time * 0.8) * w * 0.2;
			drawGradient(
				g2X,
				g2Y,
				w * 0.4,
				"rgba(92, 219, 184, 0.4)",
				"rgba(92, 219, 184, 0)",
			);

			// g3: Brand Tag Blue (Movimiento circular amplio)
			const g3X = w * 0.4 + Math.cos(time * 0.6) * w * 0.3;
			const g3Y = h * 0.6 + Math.sin(time * 0.6) * w * 0.3;
			drawGradient(
				g3X,
				g3Y,
				w * 0.4,
				"rgba(55, 114, 207, 0.4)",
				"rgba(55, 114, 207, 0)",
			);

			// g4: Testimonial Orange (Movimiento horizontal)
			const g4X = w * 0.5 + Math.sin(time * 0.7) * w * 0.4;
			drawGradient(
				g4X,
				h * 0.4,
				w * 0.4,
				"rgba(240, 150, 126, 0.45)",
				"rgba(240, 150, 126, 0)",
			);

			// g5: Hero Sky To (Círculo gigante de fondo)
			const g5X = w * 0.5 + Math.cos(time * 0.4) * w * 0.4;
			const g5Y = h * 0.5 + Math.sin(time * 0.4) * w * 0.4;
			drawGradient(
				g5X,
				g5Y,
				w * 0.8,
				"rgba(245, 233, 216, 0.45)",
				"rgba(245, 233, 216, 0)",
			);

			// Interactive: Warm White (Sigue al cursor)
			curX += (tgX - curX) / 20;
			curY += (tgY - curY) / 20;
			drawGradient(
				curX,
				curY,
				w * 0.4,
				"rgba(250, 245, 240, 0.85)",
				"rgba(250, 245, 240, 0)",
			);

			animationFrameId = requestAnimationFrame(render);
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				isVisible = entry.isIntersecting;
				if (isVisible) {
					render();
				} else {
					cancelAnimationFrame(animationFrameId);
				}
			});
		});

		observer.observe(canvas);
	}
</script>
