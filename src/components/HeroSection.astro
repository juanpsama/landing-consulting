---
import GradientBackground from "./GradientBackground.astro";

export interface Props {
	title: string;
	subtitle: string;
	cta: string;
	services: string;
}

const { title, subtitle, cta, services } = Astro.props;
---

<section
	class="relative pt-46 pb-80 px-8 flex flex-col items-center text-center overflow-hidden"
>
	<GradientBackground />
	<div class="relative z-10 w-full max-w-7xl px-8">
		<h1
			class="text-[clamp(2.25rem,5vw,72px)] font-semibold leading-[1.05] tracking-[-2px] max-w-[16ch] mx-auto text-ink"
		>
			{title}
		</h1>
		<p
			class="mt-6 text-lg font-normal leading-normal text-charcoal max-w-[48ch] mx-auto"
		>
			{subtitle}
		</p>
		<div class="mt-8 flex gap-4 flex-wrap justify-center">
			<a
				href="#contact"
				data-track="hero-cta-contacto"
				class="inline-flex items-center justify-center bg-brand-green text-primary text-base font-semibold px-7 py-3.5 rounded-lg shadow-sm hover:shadow-md hover:-translate-y-0.5 hover:bg-brand-green-deep transition-all duration-200 active:scale-95"
			>
				{cta}
			</a>

			<a
				href="#services"
				data-track="hero-cta-servicios"
				class="inline-flex items-center justify-center bg-transparent text-ink text-base font-medium px-7 py-3.5 rounded-lg border border-steel/30 shadow-sm hover:border-steel hover:bg-surface transition-all duration-200 active:scale-95 backdrop-blur-sm"
			>
				{services}
			</a>
		</div>
	</div>
</section>
