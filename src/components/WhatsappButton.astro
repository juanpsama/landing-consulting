---
// src/components/WhatsappButton.astro

interface Props {
	area_code: string;
	whatsapp: string;
}

const { area_code, whatsapp } = Astro.props;

const defaultMessage = "Hola, me gustaría agendar una cita.";
const phoneNumber = `${area_code}${whatsapp}`;
---

<div class="fixed bottom-4 right-4 z-toast">
	<a
		href={`https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`}
		target="_blank"
		rel="noopener noreferrer"
		class="bg-green-wa hover:bg-green-wa-hover p-2 text-white font-medium rounded-full shadow-lg transition-colors flex items-center justify-center w-14 h-14 active:scale-95"
		aria-label="Contactar por WhatsApp"
		data-track={`whatsapp-button-${phoneNumber}`}
	>
		<i class="ph-fill ph-whatsapp-logo text-3xl"></i>
	</a>
</div>
