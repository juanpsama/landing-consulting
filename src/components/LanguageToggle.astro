---
import { languages } from '../i18n/ui';

const currentLang = (Astro.currentLocale ?? 'es') as keyof typeof languages;
const toggleLang = currentLang === 'es' ? 'en' : 'es';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toggleUrl = `${base}/${toggleLang}/`;
---

<a href={toggleUrl} class="inline-flex items-center gap-1.5 bg-transparent text-ink text-sm font-medium px-4 py-[6px] rounded-pill no-underline border border-hairline transition-colors duration-150 hover:bg-surface">
  <span>{languages[toggleLang]}</span>
</a>
