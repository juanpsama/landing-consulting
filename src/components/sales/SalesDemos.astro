		badge: "Paquetes de alto ticket",
		resolvedFriction: [
			"Tarifario de aparatología y sesiones publicado",
			"Resultados clínicos antes/después transparentes",
			"Pre-reserva con terapeuta asignada"
		],
		prefilledMsg: "Hola, revisé su paquete de remodelación corporal. Conozco el precio de las 6 sesiones y quiero agendar mi primera cita este sábado a las 4:00 PM.",
		operationalSavings: "Ahorra 14 hrs/semana en precios",
		subdomain: "belleza.grupogarpe.com",
		fullUrl: "https://belleza.grupogarpe.com"
	},
	{
		id: "consultoria",
