---

<section id="demos" class="py-20 sm:py-28 bg-surface border-y border-hairline relative">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<!-- Section Header (Plain human language without "Silos" and without pill eyebrow) -->
		<div class="max-w-3xl mb-16">
			<h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-ink leading-tight mb-5">
				Casos reales por sector: así llega el mensaje a tu WhatsApp según tu rubro
			</h2>
			<p class="text-base sm:text-lg text-charcoal font-normal leading-relaxed">
				Revisa exactamente cómo el sistema resuelve tarifas y disponibilidad antes de que el prospecto escriba, garantizando que tu personal solo atienda a quienes ya decidieron comprar.
			</p>
		</div>

		<!-- Grid of 6 Demos with Distinct Simulated Message Cards -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
			{demos.map((demo) => (
				<div class="bg-canvas rounded-2xl border border-hairline p-6 flex flex-col justify-between shadow-2xs hover:border-text-main/30 transition-colors duration-200">
					<div>
						<!-- Header Badges -->
						<div class="flex items-center justify-between gap-2 mb-3.5">
							<span class="text-xs font-semibold text-steel">
								{demo.niche}
							</span>
							<span class="text-xs font-mono font-semibold text-brand-emerald">
								{demo.operationalSavings}
							</span>
						</div>

						<!-- Title -->
						<h3 class="text-base sm:text-lg font-bold text-ink tracking-tight mb-3">
							{demo.title}
						</h3>

						<!-- Filtered Friction Checklist -->
						<div class="space-y-1.5 mb-4 text-xs text-charcoal">
							<div class="text-[11px] font-mono uppercase text-steel mb-1">
								Filtros resueltos en tu web:
							</div>
							{demo.resolvedFriction.map((item) => (
								<div class="flex items-start gap-2">
									<i class="ph-bold ph-check text-brand-emerald shrink-0 mt-0.5"></i>
									<span class="leading-tight">{item}</span>
								</div>
							))}
						</div>

						<!-- Simulated WhatsApp Message in Authentic Bubble Tint -->
						<div class="p-3.5 rounded-xl bg-[#d9fdd3]/40 border border-[#bbf7d0] mb-5">
							<div class="flex items-center justify-between text-[11px] text-steel mb-1">
								<span class="font-medium text-charcoal">Mensaje recibido en WhatsApp:</span>
								<i class="ph-bold ph-checks text-[#53bdeb] text-xs"></i>
							</div>
							<p class="text-xs text-ink leading-relaxed italic">
								"{demo.prefilledMsg}"
							</p>
						</div>
					</div>

					<!-- Primary In-Page Conversion CTA + Discreet Secondary Demo Link -->
					<div class="pt-4 border-t border-hairline flex items-center justify-between gap-3">
						<a
							href="#conversion"
							data-track={`demo_install_${demo.id}`}
							class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-lg bg-ink text-canvas border border-ink hover:border-text-main/30 active:scale-95 transition-transform duration-150 cursor-pointer no-underline text-center"
						>
							Instalar Este Flujo
						</a>

						<a
							href={demo.fullUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-track={`demo_external_${demo.id}`}
							class="inline-flex items-center justify-center text-xs font-medium text-steel hover:text-ink transition-colors no-underline py-1 gap-1"
						>
							<span>Probar demo web</span>
							<i class="ph ph-arrow-up-right text-xs"></i>
						</a>
					</div>
				</div>
			))}
		</div>

		<!-- Reassurance Banner (rounded-2xl with rounded-xl button, no arrow) -->
		<div class="p-6 rounded-2xl bg-canvas border border-hairline flex flex-col sm:flex-row items-center justify-between gap-4 shadow-2xs">
			<div class="flex items-center gap-3">
				<i class="ph ph-gear text-2xl text-ink shrink-0"></i>
				<div class="text-xs sm:text-sm text-charcoal">
					<strong class="text-ink">¿Tu rubro tiene particularidades especiales de cotización?</strong> Diseñamos el árbol de preguntas y tarifas de tu negocio para que tu WhatsApp solo reciba prospectos que aceptan tus condiciones.
				</div>
			</div>
			<a
				href="#conversion"
				class="inline-flex items-center justify-center px-5 py-2.5 text-xs sm:text-sm font-semibold rounded-xl bg-ink text-canvas border border-ink hover:border-text-main/30 active:scale-95 transition-transform duration-150 cursor-pointer no-underline whitespace-nowrap shrink-0"
			>
				Configurar Mi Rubro
			</a>
		</div>

	</div>
</section>
