---
import { ui } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
  <div class="max-w-[1280px] mx-auto px-8 py-16 lg:py-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
      <div class="flex flex-col gap-4">
        <span class="text-sm font-semibold text-ink">{t['footer.tagline']}</span>
        <p class="text-sm text-steel leading-relaxed max-w-[32ch]">{t['footer.desc']}</p>
      </div>
      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium text-ink">{t['footer.solutions']}</span>
        <div class="flex flex-col gap-2">
          <a href="#services" class="text-sm text-steel no-underline hover:text-ink transition-colors">{t['nav.solutions']}</a>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium text-ink">{t['footer.about']}</span>
        <div class="flex flex-col gap-2">
          <a href="#" class="text-sm text-steel no-underline hover:text-ink transition-colors">{t['nav.blog']}</a>
          <a href="#" class="text-sm text-steel no-underline hover:text-ink transition-colors">{t['nav.contact']}</a>
          <a href="#" class="text-sm text-steel no-underline hover:text-ink transition-colors">{t['nav.customers']}</a>
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-hairline py-6">
    <div class="max-w-[1280px] mx-auto px-8">
      <p class="text-sm text-steel">{t['footer.copyright'].replace('{year}', String(year))}</p>
    </div>
  </div>
</footer>
