---
// src/components/Footer.astro
import { ui } from "../i18n/ui";
import Logo from "./svgs/Logo.astro";
import { getCollection } from "astro:content";

const lang = (Astro.currentLocale ?? "es") as keyof typeof ui;
const t = ui[lang];
const year = new Date().getFullYear();

const allLegals = await getCollection("legal");

const currentLangLegals = allLegals.filter((doc) =>
	doc.id.startsWith(`${lang}/`),
);

const legalLinks = currentLangLegals.map((doc) => {
	const slug: string = doc.id.split("/")[1] as string;
	const key = `footer.${slug}` as keyof typeof t;

	return {
		text: t[key] || doc.data.title,
		href: `/${lang}/legal/${slug}`,
	};
});

const columns = [
	{
		title: t["footer.pages"],
		links: [
			{ text: t["nav.solutions"], href: "#services" },
			// { text: t["nav.blog"], href: "#" },
			{ text: t["nav.contact"], href: "#" },
			// { text: t["nav.customers"], href: "#" },
		],
	},
	{
		title: t["footer.socials"],
		links: [
			// { text: "LinkedIn", href: null },
			// { text: "Twitter", href: null },
			// { text: "GitHub", href: null },
			// { text: "YouTube", href: null },
			{ text: "Telegram", href: "https://t.me/grupogarpe" },
		],
	},
	{
		title: t["footer.legal"],
		links: legalLinks,
	},
];
---

<footer
	class="border-t border-hairline bg-canvas relative w-full overflow-hidden px-8 py-20"
>
	<div
		class="mx-auto flex max-w-7xl flex-col items-start justify-between text-sm text-neutral-500 sm:flex-row md:px-8"
	>
		<div>
			<div class="mr-0 mb-4 md:mr-4 md:flex md:items-center md:gap-2">
				<Logo
					class="w-6 h-6 text-[#1A2333]"
					aria-label="Logo"
					aria-hidden="false"
				/>
				<span class="text-sm font-semibold text-ink"
					>{t["footer.tagline"]}</span
				>
			</div>
			<p class="text-sm text-steel mb-2">
				{t["footer.copyright"].replace("{year}", String(year))}
			</p>
			<p class="text-sm text-steel leading-relaxed max-w-[32ch]">
				{t["footer.desc"]}
			</p>
		</div>
		<div
			class="mt-10 grid grid-cols-1 items-start gap-10 sm:mt-0 md:mt-0 lg:grid-cols-3"
		>
			{
				columns.map((column) => (
					<div class="flex flex-col gap-4">
						<span class="text-sm font-medium text-ink">
							{column.title}
						</span>
						<div class="flex flex-col gap-2">
							{column.links.map((link) => {
								if (!link.href) {
									return null;
								}

								const isExternal =
									link.href?.startsWith("http") ?? false;

								if (isExternal) {
									return (
										<a
											href={link.href}
											target="_blank"
											rel="noopener noreferrer"
											data-track={`footer-nav-${link.text.toLowerCase()}`}
											class="text-sm text-steel no-underline hover:text-ink transition-colors"
										>
											{link.text}
										</a>
									);
								}

								return (
									<a
										href={link.href}
										data-track={`footer-nav-${link.text.toLowerCase()}`}
										class="text-sm text-steel no-underline hover:text-ink transition-colors"
									>
										{link.text}
									</a>
								);
							})}
						</div>
					</div>
				))
			}
		</div>
	</div>
	<div
		aria-hidden="true"
		class="mt-20 text-center font-bold tracking-tighter select-none pointer-events-none bg-linear-to-b from-neutral-50 to-neutral-200 bg-clip-text text-transparent text-[clamp(3rem,12vw,12rem)] leading-none"
	>
		Grupo GARPE
	</div>
</footer>
