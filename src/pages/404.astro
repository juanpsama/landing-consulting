---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui";

const lang = (Astro.currentLocale ?? "es") as keyof typeof ui;
const t = ui[lang];

const title = `Página no encontrada`;
const description =
	"Parece que esta ruta no existe. Te ayudamos a volver al inicio.";
---

<Layout lang={lang} title={title} description={description}>
	<main
		class="relative flex flex-col min-h-[80dvh] items-center justify-center overflow-hidden px-6 py-24 text-center"
	>
		<div
			aria-hidden="true"
			class="absolute inset-0 -z-10 flex items-center justify-center font-bold tracking-tighter select-none pointer-events-none bg-linear-to-b from-neutral-50 to-neutral-200 bg-clip-text text-transparent text-[clamp(10rem,35vw,35rem)] leading-none"
		>
			404
		</div>

		<div class="z-10 flex max-w-2xl flex-col items-center gap-6">
			<div
				class="inline-flex items-center rounded-pill border border-hairline bg-surface px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-steel"
			>
				Ruta no encontrada
			</div>

			<h1
				class="text-4xl font-extrabold tracking-tight text-ink sm:text-6xl lg:text-7xl"
			>
				Esta página no existe{" "}
				(<span
					class="bg-linear-to-br from-brand-tag to-brand-green-deep bg-clip-text text-transparent"
				>
					todavía
				</span>).
			</h1>

			<p class="text-lg text-steel max-w-xl leading-relaxed">
				El enlace que buscas puede haber cambiado o ya no está disponible. Mientras tanto, te ayudamos a volver a un entorno estable.
			</p>

			<div
				class="mt-6 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto"
			>
				<a
					href="/"
					class="inline-flex w-full sm:w-auto items-center justify-center rounded-pill bg-[#0a0a0a] px-8 py-3.5 text-sm font-semibold text-white transition-transform duration-200 hover:scale-105 active:scale-95"
				>
					Volver al inicio
				</a>
				<a
					href={`/${lang}/#services`}
					class="inline-flex w-full sm:w-auto items-center justify-center rounded-pill border border-hairline bg-surface px-8 py-3.5 text-sm font-medium text-ink transition-colors duration-200 hover:bg-hairline"
				>
					Explorar servicios
				</a>
			</div>
		</div>
	</main>
</Layout>
