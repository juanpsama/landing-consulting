---
// src/pages/[locale]/team/[slug].astro
export const prerender = true;
import { teamMembers } from "../../../data/links";
import Layout from "../../../layouts/Layout.astro";
import { ui } from "../../../i18n/ui";

export function getStaticPaths() {
  const locales = ["es", "en"];
  const paths = [];

  for (const locale of locales) {
    for (const slug of Object.keys(teamMembers)) {
      paths.push({
        params: { locale, slug },
      });
    }
  }

  return paths;
}

const { locale, slug } = Astro.params as { locale: string; slug: string };
const member = teamMembers[slug];

if (!member) {
  return Astro.redirect("/404");
}

const t = ui[locale as keyof typeof ui];
---

<Layout lang={locale} title={`${member.name}`}>
  <main class="max-w-3xl mx-auto px-6 py-20 min-h-dvh">
    <div class="flex items-center gap-6 mb-8">
      <div
        class="w-32 h-32 rounded-xl overflow-hidden border border-slate-200 shadow-sm"
      >
        {
          member.avatarUrl ? (
            <img
              src={member.avatarUrl}
              alt={member.name}
              class="w-full h-full object-cover grayscale-20"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-slate-200 text-slate-500">
              <span class="text-4xl font-mono">
                {member.name?.slice(0, 2).toUpperCase()}
              </span>
            </div>
          )
        }
      </div>
      <div>
        <h1 class="text-4xl font-geist text-[#1A2333] mb-2">
          {member.name}
        </h1>
        <p class="text-lg font-mono text-[#D97706]">
          {member.role}
        </p>
      </div>
    </div>
    <section class="prose prose-slate mb-6">
      <p>
        {t["member.slogan"]}
      </p>
    </section>
    <a
      href={"/" + locale + "/#services"}
      class="bg-brand-green text-primary text-base font-semibold px-7 py-3.5 rounded-lg shadow-sm hover:shadow-md hover:bg-brand-green-deep transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 active:scale-95"
    >
      {t["hero.services"]}
    </a>
  </main>

  <div
    id="vcard-modal"
    class="hidden fixed inset-0 bg-[#1A2333]/80 backdrop-blur-sm flex items-center justify-center p-4 z-50"
  >
    <div
      class="bg-white rounded-2xl max-w-sm w-full p-8 text-center shadow-2xl border border-slate-100 relative"
    >
      <div
        class="absolute top-4 left-4 text-slate-100 font-mono text-4xl opacity-50 select-none"
      >
        &#123; G &#125;
      </div>

      <div
        class="w-20 h-20 mx-auto mb-5 rounded-full overflow-hidden border-4 border-white shadow-md relative z-10"
      >
        {
          member.avatarUrl ? (
            <img
              src={member.avatarUrl}
              alt={member.name}
              class="w-full h-full object-cover grayscale-20"
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center bg-slate-200 text-slate-500">
              <span class="text-4xl font-mono">
                {member.name?.slice(0, 2).toUpperCase()}
              </span>
            </div>
          )
        }
      </div>

      <h3 class="text-2xl font-geist text-[#1A2333] mb-2">
        {t["member.greeting"].replace("{name}", member.name)}
      </h3>
      <p class="text-sm font-inter text-slate-500 mb-8 px-2">
        {t["member.subtitle"]}
      </p>

      <a
        href={`/api/vcard/${slug}/`}
        class="block w-full py-3.5 bg-[#D97706] hover:bg-[#b46204] text-white font-inter font-medium rounded-lg transition-colors mb-4 shadow-lg shadow-[#D97706]/20"
      >
        {t["member.modal_button"]}
      </a>

      <button
        id="close-modal-btn"
        class="text-sm font-inter text-slate-400 hover:text-[#1A2333] underline underline-offset-2 transition-colors"
      >
        {t["member.modal_close"]}
      </button>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const modal = document.getElementById("vcard-modal");
    const closeBtn = document.getElementById("close-modal-btn");

    if (urlParams.get("action") === "vcard" && modal) {
      modal.classList.remove("hidden");
    }

    if (closeBtn && modal) {
      closeBtn.addEventListener("click", () => {
        modal.classList.add("hidden");
        // Limpia el ?action=vcard de la barra de navegación sin recargar
        window.history.replaceState(
          {},
          document.title,
          window.location.pathname,
        );
      });
    }
  });
</script>
