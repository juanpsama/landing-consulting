---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui';

export async function getStaticPaths() {
  return [
    { params: { locale: 'es' } },
    { params: { locale: 'en' } },
  ];
}

const lang = (Astro.currentLocale ?? 'es') as keyof typeof ui;
const t = ui[lang];
const h1 = t['hero.title'];
---

<!-- TODO: make a global state or something to avoid prop driling -->
<Layout
  lang={lang}
  title={t['hero.title']}
  description={t['hero.subtitle']}
  h1={h1}
  subtitle={t['hero.subtitle']}
  cta={t['hero.cta']}
  services={t['hero.services']}
/>
