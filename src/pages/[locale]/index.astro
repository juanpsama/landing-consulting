---
// src/pages/[locale]/index.astro
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
// import ServicesSection from '../components/ServicesSection.astro';
import ServicesSection from "../../components/ServicesSection_0001.astro";
import { ui } from "../../i18n/ui";

export async function getStaticPaths() {
	return [{ params: { locale: "es" } }, { params: { locale: "en" } }];
}

const lang = (Astro.currentLocale ?? "es") as keyof typeof ui;
const t = ui[lang];
const h1 =
	lang === "en"
		? "Development, Consulting & <span>Automation</span> for SMBs"
		: "Desarrollo, Consultoría y <span>Automatización</span> para empresas";
---

<Layout lang={lang}>
	<HeroSection
		{h1}
		subtitle={t["hero.subtitle"]}
		cta={t["hero.cta"]}
		services={t["hero.services"]}
	/>
	<ServicesSection />
</Layout>
