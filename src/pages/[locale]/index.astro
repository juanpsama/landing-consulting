---
// src/pages/[locale]/index.astro
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import HeroSection from "../../components/HeroSection.astro";
// import ServicesSection from '../components/ServicesSection.astro';
import ServicesSection from "../../components/ServicesSection_0001.astro";
import { ui, languages } from "../../i18n/ui";
import ContactSection from "../../components/ContactSection.astro";

export async function getStaticPaths() {
	return Object.keys(languages).map((locale) => ({
		params: { locale },
	}));
}

const lang = (Astro.currentLocale ?? "es") as keyof typeof ui;
const t = ui[lang];
---

<Layout lang={lang}>
	<HeroSection
		title={t["hero.title"]}
		subtitle={t["hero.subtitle"]}
		cta={t["hero.cta"]}
		services={t["hero.services"]}
	/>
	<ServicesSection />
	<ContactSection />
</Layout>
