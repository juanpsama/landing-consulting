{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "landing-garpe-astro",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"routes": [
		{
			"pattern": "grupogarpe.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
			"zone_name": "grupogarpe.com"
		},
		{
			"pattern": "garpe.dev",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false,
			"zone_name": "garpe.dev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "1394fe7a5de743569586e01a590cb9ac"
		}
	]
}